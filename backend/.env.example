# Copia questo file in .env e personalizza i valori.

# Ambiente: development | production
APP_ENV=development

# Stringa di connessione DB.
# Sviluppo locale (default se non impostata): sqlite:///./officepresence.db
# Produzione (MySQL su cPanel), esempio:
# DATABASE_URL=mysql+pymysql://utente:password@localhost/nome_db
DATABASE_URL=sqlite:///./officepresence.db

# Nome del cookie usato per memorizzare il codice sessione nel browser
SESSION_COOKIE_NAME=officepresence_session

# Durata del cookie di sessione, in giorni
SESSION_COOKIE_MAX_AGE_DAYS=365

# Origini consentite per CORS (separate da virgola), utile in sviluppo
# con frontend su un'altra porta (es. Vite su http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chiave Google Maps/Places (Places API "New" abilitata sul progetto Google
# Cloud). Usata per la ricerca aziende in onboarding (GET /company/search) e
# come fallback automatico di sede/sito quando l'utente non indica un sito.
# Senza questa chiave l'app funziona comunque: la ricerca resta disattivata.
GOOGLE_MAPS_API_KEY=
